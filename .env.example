# Local PostgreSQL (development)
DATABASE_URL="postgresql://USER@localhost:5432/liveshift"
DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/liveshift"

# Neon PostgreSQL (production / Vercel)
# Pooled connection used by the app (hostname includes -pooler)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct / unpooled connection used by Prisma CLI (migrate, db push, studio)
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JOSE signing secret — generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# AES-256-GCM key for POS credential storage. Falls back to AUTH_SECRET when unset.
# INTEGRATION_SECRET="replace-with-a-long-random-secret"

# Public origin used in email links and redirects
APP_URL="http://localhost:3000"

# Resend transactional email
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="LiveShift <noreply@example.com>"

# Optional seed for the first platform operator
SUPER_ADMIN_EMAIL="owner@liveshift.app"
SUPER_ADMIN_PASSWORD="change-me"
SUPER_ADMIN_FIRST_NAME="Platform"
SUPER_ADMIN_LAST_NAME="Admin"

# Public client demo. COMPANY_ADMIN on Citlatli. Open /demo or sign in with these.
DEMO_EMAIL="demo@liveshift.app"
DEMO_PASSWORD="liveshift-demo"

# Bearer token for GET /api/cron/integrations and GET /api/cron/billing. Required in production.
# CRON_SECRET="replace-with-a-long-random-secret"

# Company billing catalog. Amounts are per restaurant location and are never hardcoded in app logic.
BILLING_CURRENCY="USD"
BILLING_TRIAL_DAYS="14"
BILLING_PLAN_STARTER_NAME="Starter"
BILLING_PLAN_STARTER_ORDER="0"
BILLING_PLAN_STARTER_DESCRIPTION="For groups opening LiveShift across every house. Company billing, priced per restaurant location."
BILLING_PLAN_STARTER_FEATURES="Live 86 board, inventory, waste, and line tasks|Sales and labor for each restaurant|Manager logs isolated by house|Company billing priced per location|Email invoices to billing administrators"
BILLING_PLAN_GROWTH_NAME="Growth"
BILLING_PLAN_GROWTH_ORDER="1"
BILLING_PLAN_GROWTH_DESCRIPTION="For larger groups that need more locations on the same company invoice, with upgrades as houses are added."
BILLING_PLAN_GROWTH_FEATURES="Everything in Starter|Company operations dashboard across every house|Upgrade, downgrade, and billed location quantity|Dedicated billing administrator separate from the floor|POS integrations and audit history"
BILLING_PRICE_STARTER_MONTHLY="299"
BILLING_PRICE_STARTER_ANNUAL="2990"
BILLING_PRICE_GROWTH_MONTHLY="499"
BILLING_PRICE_GROWTH_ANNUAL="4999"
